# Copia este archivo como .env.local y ajusta los valores.

# De dónde salen los datos: simulada (por defecto) | api
VITE_FUENTE=simulada

# Solo si VITE_FUENTE=api. En planta: /api · en la nube: URL de API Gateway
VITE_API_URL=/api

# Panel del simulador de fallas (botón "Demo"). En producción: false
VITE_DEMO=true

# Login: cognito (nube) | simulada (usuarios de demo) | api (login del Edge). Por defecto sigue a VITE_FUENTE.
# VITE_AUTH=simulada

# Solo si VITE_AUTH=cognito. Los dos datos están en la consola de Cognito (no son secretos).
# El app client debe ser público (sin secreto) y tener ALLOW_USER_PASSWORD_AUTH.
# VITE_COGNITO_REGION=us-east-1
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
