# {{ ansible_managed }}
# Edge de la sede {{ sede }} ({{ inventory_hostname }}). Generado por ansible/edge-baseline.yml.

MQTT_HOST={{ mqtt_host }}
MQTT_PORT={{ mqtt_port }}
MQTT_TLS=1
MQTT_VERSION=5
MQTT_USUARIO={{ mqtt_usuario }}
MQTT_CLAVE={{ mqtt_clave | default('') }}
MQTT_CLIENT_ID=edge-{{ sede }}-ansible

AWS_API_URL={{ aws_api_url }}
CLAVE_INGESTA={{ clave_ingesta | default('') }}

# Una sede por equipo, como en el diseño (en la demo local un solo Edge atiende las dos).
LOCALES={{ local_id }}
SYNC_SEG=30
DB=edge.db

API_HOST=0.0.0.0
API_PORT={{ api_port }}
DEMO=0
