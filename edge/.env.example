# Copia este archivo como edge/.env y completa las claves (edge/.env NO se sube al repo).

# ---- Broker MQTT (docs/broker-mqtt.md) ----
MQTT_HOST=gb12d98f.ala.us-east-1.emqxsl.com
MQTT_PORT=8883
MQTT_TLS=1
MQTT_VERSION=5
MQTT_USUARIO=edge-local1
MQTT_CLAVE=
MQTT_CLIENT_ID=edge-local-01
# Opcional: ruta al certificado CA del broker (si no, usa los certificados del sistema)
MQTT_CA=

# ---- AWS (backend/README.md) ----
AWS_API_URL=https://3j82c54obf.execute-api.us-east-1.amazonaws.com
CLAVE_INGESTA=

# ---- Funcionamiento ----
LOCALES=local1,local2
SYNC_SEG=30
DB=edge.db

# ---- Seguridad (días y HH sin incidentes, siguen el calendario real) ----
# Fecha del último incidente con tiempo perdido. Registrar uno nuevo = cambiar la fecha y reiniciar el Edge.
FECHA_INCIDENTE_LOCAL1=2026-08-29
FECHA_INCIDENTE_LOCAL2=2026-06-23
# Para estimar las HH anteriores a la instalación del Edge (días hábiles x dotación x turno)
PERSONAL_TURNO_LOCAL1=18
PERSONAL_TURNO_LOCAL2=20
HORAS_TURNO=9

# ---- Simulador de los ESP32 (solo pruebas) ----
ESP32_LOCAL1_CLAVE=
ESP32_LOCAL2_CLAVE=
